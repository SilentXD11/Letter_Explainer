# Copy to .env and fill in ONE key. With no key the app runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (anthropic | openai | offline)
# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4.1-mini

# Below this OCR confidence (0-100) the photo is sent to the vision model
OCR_MIN_CONFIDENCE=70
# Tesseract languages, e.g. eng or eng+hin (install the language pack first)
OCR_LANG=eng
